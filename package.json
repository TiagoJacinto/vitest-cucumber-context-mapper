{
  "name": "vitest-cucumber-context-mapper",
  "version": "0.3.0",
  "description": "Type-safe Gherkin scenarios for Vitest with functions, generators and Standard Schema",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TiagoJacinto/vitest-cucumber-context-mapper.git"
  },
  "type": "module",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=24.11.0"
  },
  "files": [
    "dist/",
    "src/*.ts",
    "mapper/*.ts",
    "oxlint/*.mjs",
    "README.md",
    "docs/*.md",
    "scripts/generate-tests.mjs"
  ],
  "exports": {
    "./vite": {
      "types": "./dist/src/vite-plugin.d.ts",
      "default": "./dist/src/vite-plugin.js"
    },
    "./oxlint": "./oxlint/gherkin-steps.mjs",
    "./bdd": {
      "types": "./dist/src/effect-runtime.d.ts",
      "default": "./dist/src/effect-runtime.js"
    },
    "./gherkin": {
      "types": "./dist/src/gherkin.d.ts",
      "default": "./dist/src/gherkin.js"
    }
  },
  "typescript": {
    "contentMapper": {
      "exec": [
        "node",
        "dist/mapper/server.js"
      ],
      "compilerOptions": [],
      "dynamicConfig": false
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "pretypecheck": "npm run build",
    "typecheck": "tsc --noEmit --runExternalCode",
    "pretest": "npm run build",
    "test": "vitest run",
    "verify": "npm run typecheck && npm test && node scripts/verify-compiler.mjs",
    "verify:package": "node scripts/verify-package.mjs",
    "verify:release": "npm run verify && npm run lint && npm run verify:package",
    "prelint": "npm run build",
    "lint": "oxlint",
    "lint:fix": "npm run build && oxlint --fix",
    "prepack": "npm run build",
    "prepublishOnly": "npm run verify:release",
    "preprobe:lsp": "npm run build",
    "probe:lsp": "node scripts/probe-lsp.mjs",
    "probe:fluent": "npm run verify",
    "pretest:browser": "npm run build",
    "test:browser": "vitest run --config vitest.browser.config.ts"
  },
  "dependencies": {
    "@cucumber/gherkin": "42.0.1",
    "@cucumber/messages": "34.2.1",
    "@standard-schema/spec": "1.1.0",
    "parsecurrency": "1.1.1",
    "ts-content-mapper": "0.1.0"
  },
  "peerDependencies": {
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "devDependencies": {
    "@amiceli/vitest-cucumber": "8.0.0",
    "@types/node": "24.10.0",
    "@vitest/browser-playwright": "5.0.5",
    "gherkin-content-mapper": "file:./mapper",
    "oxfmt": "0.75.0",
    "oxlint": "1.89.0",
    "playwright": "1.64.1",
    "typescript": "7.1.0-dev.20261023.1",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "zod": "4.6.7"
  },
  "bin": {
    "gherkin-tests": "scripts/generate-tests.mjs"
  }
}
